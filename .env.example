# URL pública do site (usada em canonical, hreflang, sitemap e Open Graph).
# Se ficar por preencher, o site usa o domínio de produção por omissão, e nas
# pré-visualizações da Vercel usa o domínio do próprio deploy.
NEXT_PUBLIC_SITE_URL=https://enrichedstudio.com

# Envio do formulário de contacto por email (opcional).
# Sem estas variáveis o formulário continua a funcionar: valida os dados e regista no servidor.
RESEND_API_KEY=
CONTACT_TO=geral@enrichedstudio.com
CONTACT_FROM=Website <onboarding@resend.dev>
